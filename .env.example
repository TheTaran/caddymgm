PUID=1000
PGID=1000
CADDYMGM_ADMIN_USER=admin
CADDYMGM_ADMIN_PASSWORD=changeme
CADDYMGM_AUTH_ENABLED=true
CADDYMGM_LOCALAUTH_ENABLED=true
CADDYMGM_OIDCAUTH_ENABLED=false
CADDYMGM_CADDY_MODE=file
CADDYMGM_CADDY_API_URL=http://caddy:2019
CADDYMGM_ACCESS_LOG_DIR=/logs
CADDYMGM_CADDY_DATA_DIR=/caddy-data
CADDYMGM_CA_CERT_DIR=/ca-certificates
CADDYMGM_WEB_LISTEN=:8080
CADDYMGM_SETTINGS_PATH=/caddymgm-config/caddymgm-settings.json
CADDYMGM_WEB_ACME_HOME=/caddymgm-data/acme
CADDYMGM_WEB_TLS_DIR=/caddymgm-data/tls
CADDYMGM_WEB_TLS_CERT_FILE=/caddymgm-data/tls/caddymgm.crt
CADDYMGM_WEB_TLS_KEY_FILE=/caddymgm-data/tls/caddymgm.key
CADDYMGM_WEB_TLS_CA_FILE=/caddymgm-data/tls/caddymgm-ca.crt
CADDYMGM_WEB_DNS_PROVIDER=
CADDYMGM_WEB_DNS_SLEEP=
CADDY_ACCESS_LOG_DIR=/logs
COMPOSE_PROFILES=docker-caddy
CADDY_IMAGE=caddy:2-alpine
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
